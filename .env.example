# Copy to .env.local (development) or set in the host's dashboard (production).
# S6: everything below is SERVER-ONLY. Never add a NEXT_PUBLIC_ prefix to a secret.

# Public origin of the store: canonical URLs, sitemap, Open Graph, and the
# return/callback URLs sent to the payment provider. (Public by design.)
NEXT_PUBLIC_SITE_URL=https://www.example.com.br

# --- Orders and newsletter ---------------------------------------------------
# "supabase" for a real store. "memory" = demo only: orders vanish on restart.
# In production this MUST be set explicitly; the app refuses to guess.
PERSISTENCE=supabase
# Project Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings → API Keys → the secret / service_role key. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ----------------------------------------------------------------
# "mercadopago" for a real store. "fake" = demo only: Pix is fictional, cards always approve.
# In production this MUST be set explicitly; the app refuses to guess.
PAYMENT_GATEWAY=mercadopago
# Your integrations → application → Credentials → Access Token (TEST- for sandbox, APP_USR- for production)
MERCADOPAGO_ACCESS_TOKEN=
# Your integrations → application → Webhooks → Secret signature
MERCADOPAGO_WEBHOOK_SECRET=
